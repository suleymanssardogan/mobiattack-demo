{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MobiAttack Demo 3 Baseline Report",
  "description": "Standardized machine-readable contract for deterministic mobile security static analysis.",
  "type": "object",
  "required": [
    "schema_version",
    "scan",
    "artifact",
    "analysis",
    "inventory",
    "static_findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "scan": {
      "type": "object",
      "required": ["run_id", "status", "errors", "warnings"],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "partial", "failed"]
        },
        "timestamp": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["source", "filename", "sha256", "package_name"],
      "properties": {
        "source": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "package_name": {
          "type": "string"
        },
        "size_bytes": {
          "type": ["integer", "null"]
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "files_discovered",
        "files_analyzed",
        "files_skipped",
        "files_failed"
      ],
      "properties": {
        "files_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "files_analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "files_failed": {
          "type": "integer",
          "minimum": 0
        },
        "failed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "reason"],
            "properties": {
              "file": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "required": ["candidate_count", "candidates"],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "value",
              "occurrence_count",
              "occurrences"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["url", "domain", "api_path", "ip_address", "websocket_url", "base_url"]
              },
              "value": {
                "type": "string"
              },
              "components": {
                "type": "object"
              },
              "occurrence_count": {
                "type": "integer",
                "minimum": 1
              },
              "occurrences": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "source_file",
                    "extraction_method",
                    "raw_value",
                    "evidence"
                  ],
                  "properties": {
                    "source_file": { "type": "string" },
                    "line_number": { "type": "integer" },
                    "extraction_method": { "type": "string" },
                    "raw_value": { "type": "string" },
                    "evidence": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "static_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "title", "severity"],
        "properties": {
          "id": { "type": "string" },
          "rule_id": { "type": "string" },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "category": { "type": "string" },
          "source_file": { "type": "string" },
          "evidence": { "type": ["string", "object", "null"] },
          "description": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
