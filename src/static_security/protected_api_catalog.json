      "signature": "Landroid/app/NotificationManager;->notify(ILandroid/app/Notification;)V",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "context_rule": "conditional",
      "context_note": "Device API 33+ and notification exemptions required; target SDK alone insufficient.",
      "official_source": "https://developer.android.com/develop/ui/compose/notifications/notification-permission",
      "api_min_sdk": 1
    },
    {
